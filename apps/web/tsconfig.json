{
  "extends": "@crm/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"]
  },
  "include": ["src", "bundler", "build.ts", "node_modules/@crm/typescript-config/assets.d.ts"]
}
