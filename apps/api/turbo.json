{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["//#infra:up", "//#setup:env", "@crm/core#db:migrate"],
      "passThroughEnv": [
        "PORT",
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "WEB_ORIGIN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "ELECTRIC_URL",
        "ELECTRIC_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "S3_BUCKET",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_PUBLIC_URL",
        "AI_GATEWAY_API_KEY"
      ]
    }
  }
}
