PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/crm"
REDIS_URL="redis://localhost:56379"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"
# Google OAuth client (Web application). Authorized redirect URI:
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ElectricSQL sync service from compose.yaml, reached only by the API's shape proxy.
# The secret must match compose's ELECTRIC_SECRET (its local default is below).
ELECTRIC_URL="http://127.0.0.1:53000"
ELECTRIC_SECRET="crm-local-electric-secret-change-me"
# Image storage (profile pictures, workspace favicons). With BLOB_READ_WRITE_TOKEN set the API
# uses Vercel Blob; otherwise an S3-compatible store. The S3 defaults match the local RustFS
# container in compose.yaml, so leave them unset in development.
# BLOB_READ_WRITE_TOKEN=""
# S3_BUCKET="crm"
# S3_ENDPOINT="http://127.0.0.1:59000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="crm-local"
# S3_SECRET_ACCESS_KEY="crm-local-secret"
# S3_PUBLIC_URL="http://127.0.0.1:59000/crm"
