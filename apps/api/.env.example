PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/crm"
REDIS_URL="redis://localhost:56379"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"
# Google OAuth client (Web application). Authorized redirect URI:
#   http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# ElectricSQL sync service from compose.yaml, reached only by the API's shape proxy.
# The secret must match compose's ELECTRIC_SECRET (its local default is below).
ELECTRIC_URL="http://127.0.0.1:53000"
ELECTRIC_SECRET="crm-local-electric-secret-change-me"

# The eve agent (apps/agent). It reaches connected apps through the MCP gateway at /api/mcp.
AGENT_URL="http://localhost:2000"
