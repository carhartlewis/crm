# The CRM API: session checks, the MCP gateway and memory.
# CRM_API_URL="http://localhost:3001"
# REDIS_URL="redis://localhost:56379"
# Vercel AI Gateway key for Jev, the judge that decides what a chat adds to memory. Without it,
# chats are still stored in memory but no single facts are kept from them.
AI_GATEWAY_API_KEY=""
# Jev's model on the gateway.
# JEV_MODEL="anthropic/claude-haiku-5.5"
# Shared with the API (apps/api/.env): the only caller this agent accepts for chats. At least 32
# characters; must match the API's value.
AGENT_PROXY_SECRET=""
