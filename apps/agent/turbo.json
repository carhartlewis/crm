{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": [".eve/**", ".output/**"]
    },
    "dev": {
      "env": ["CRM_API_URL", "REDIS_URL", "AGENT_PROXY_SECRET"],
      "with": ["@crm/api#dev"]
    }
  }
}
