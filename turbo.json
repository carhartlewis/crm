{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#infra:up": {
      "cache": false,
      "passThroughEnv": ["ELECTRIC_SECRET"]
    },
    "//#setup:env": {
      "cache": false
    }
  },
  "agentGuidance": true,
  "globalDependencies": ["bunfig.toml"]
}
