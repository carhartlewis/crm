{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.agents",
      "!!.claude/skills",
      "!!.scratch",
      "!!.cache",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/coverage",
      "!!**/.turbo",
      "!!**/.vercel",
      "!!**/.output",
      "!!**/.eve",
      "!**/*.generated.*",
      "!**/routeTree.gen.ts",
      "!**/src/prisma/contract.json",
      "!**/src/prisma/contract.d.ts",
      "!**/migrations/**",
      "!bun.lock",
      "!skills-lock.json",
      "!AGENTS.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": true
    }
  },
  "yaml": {
    "formatter": {
      "enabled": true
    }
  }
}
