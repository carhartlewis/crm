{
  "extends": "@crm/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "paths": {
      "@crm/ui/*": ["./src/*"]
    }
  },
  "include": ["src", "node_modules/@crm/typescript-config/assets.d.ts"]
}
