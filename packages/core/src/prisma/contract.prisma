// use prisma-8

// better-auth tables. Prisma owns their migrations; better-auth reads and writes
// them through the shared pg.Pool. Keep fields in sync with `getAuthTables` from
// "better-auth/db" when the auth config or plugins change.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  memberships   Member[]
  invitations   Invitation[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  connections        Connection[]
  skills             Skill[]
  customConnectors   CustomConnector[]
  chats              Chat[]
  chatSpaces         ChatSpace[]
  sidebars           Sidebar[]
  spaceMemberships   ChatSpaceMember[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  // The workspace this session acts in (better-auth `activeOrganizationId`).
  activeOrganizationId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

// Workspaces: better-auth organizations, stored as `workspace` (see `workspaces` in src/auth/server.ts).

model Workspace {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  website     String
  createdAt   DateTime
  members     Member[]
  invitations Invitation[]
  connections Connection[]
  skills      Skill[]
  customConnectors CustomConnector[]
  memoryFacts MemoryFact[]
  chats       Chat[]
  chatSpaces  ChatSpace[]
  sidebars    Sidebar[]
  spaceMembers ChatSpaceMember[]

  @@map("workspace")
}

model Member {
  id             String    @id
  organizationId String
  workspace      Workspace @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String    @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String    @id
  organizationId String
  workspace      Workspace @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String    @default("pending")
  expiresAt      DateTime
  createdAt      DateTime
  inviterId      String
  inviter        User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// CRM records. Synced to clients through Electric shapes (one per table, filtered by
// workspace), so columns are snake_case: shape rows reach the browser with these keys.

model Company {
  // Client-generated (`createId("com")`, or a UUID from before prefixes): the web app inserts
  // the row optimistically before the API call.
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  domain      String?
  ownerId     String?   @map("owner_id")
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @onUpdate(now()) @map("updated_at")
  memoryFacts MemoryFact[]

  @@index([workspaceId])
  @@map("company")
}

// A copy of one fact Supermemory read from a workspace's or company's memory (ADR 0017), so
// ⌘K searches facts locally. The API refreshes it from Supermemory; nothing else writes it.
// Synced to members of the workspace through Electric.

model MemoryFact {
  // Supermemory's fact id: the copy's natural key.
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Null for the workspace's own memory.
  companyId   String?   @map("company_id")
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  text        String
  // A lasting fact rather than a current one.
  isStatic    Boolean   @map("is_static")
  // When Supermemory read the fact.
  createdAt   DateTime  @map("created_at")
  // When the API last copied it.
  syncedAt    DateTime  @map("synced_at")

  @@index([workspaceId])
  @@index([companyId])
  @@map("memory_fact")
}

// better-auth `jwt` plugin: signing keys for MCP access tokens (served at /api/auth/jwks).

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// `@better-auth/mcp`: the CRM as an OAuth 2.1 authorization server for MCP clients (the agent).
// Field types follow better-auth's own Postgres DDL: string lists and JSON are jsonb.

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json(storage: jsonb)?
  clientCredentialsScopes          Json(storage: jsonb)?
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json(storage: jsonb)?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     Json(storage: jsonb)
  postLogoutRedirectUris           Json(storage: jsonb)?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json(storage: jsonb)?
  responseTypes                    Json(storage: jsonb)?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?
  referenceId                      String?
  metadata                         Json(storage: jsonb)?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json(storage: jsonb)?
  customClaims                  Json(storage: jsonb)?
  dpopBoundAccessTokensRequired Boolean?
  disabled                      Boolean?
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?
  metadata                      Json(storage: jsonb)?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String                @id
  clientId   String
  client     OauthClient           @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource         @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json(storage: jsonb)?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String                @id
  token                   String                @unique
  clientId                String
  client                  OauthClient           @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               Json(storage: jsonb)?
  requestedUserInfoClaims Json(storage: jsonb)?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json(storage: jsonb)?
  scopes                  Json(storage: jsonb)
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String                @id
  token                   String                @unique
  clientId                String
  client                  OauthClient           @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               Json(storage: jsonb)?
  requestedUserInfoClaims Json(storage: jsonb)?
  refreshId               String?
  refresh                 OauthRefreshToken?    @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json(storage: jsonb)?
  scopes                  Json(storage: jsonb)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String                @id
  clientId                String
  client                  OauthClient           @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               Json(storage: jsonb)?
  requestedUserInfoClaims Json(storage: jsonb)?
  scopes                  Json(storage: jsonb)
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// A user's connection to an app (`@crm/integrations`) in one workspace. The agent reaches it
// through the MCP gateway at /api/mcp. `credentials` is the OAuth client registration and
// tokens, encrypted with BETTER_AUTH_SECRET; it never leaves the API.

model Connection {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Catalog id, such as "granola".
  integration String
  // "read" or "write" (see `access.ts` in @crm/integrations).
  access      String
  credentials String
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  @@unique([workspaceId, userId, integration])
  @@index([userId])
  @@map("connection")
}

// A skill shared by everyone in a workspace (`@crm/integrations` skills). The agent loads the
// enabled ones each turn. Installed from skills.sh (pinned copy; `source_id` is the skills.sh id)
// or written in the CRM. New skills start enabled (ADR 0015).

model Skill {
  id          String               @id
  workspaceId String               @map("workspace_id")
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Lowercase letters, digits and hyphens; the name the agent loads it by.
  name        String
  description String
  // The SKILL.md body, without its frontmatter.
  content     String
  // Other files of the skill package, by relative path.
  files       Json(storage: jsonb)
  // "skills.sh" or "custom".
  source      String
  sourceId    String?              @map("source_id")
  enabled     Boolean
  addedById   String?              @map("added_by_id")
  addedBy     User?                @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @map("created_at")
  updatedAt   DateTime             @map("updated_at")

  @@unique([workspaceId, name])
  @@map("skill")
}

// A remote MCP server a workspace added by URL (`custom.ts` in @crm/integrations). Everyone in
// the workspace sees it; each person connects to it on their own, as with catalog apps.

model CustomConnector {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Slug of the name; the connector's id, tool prefix and `connection.integration`.
  key         String
  name        String
  mcpUrl      String    @map("mcp_url")
  addedById   String?   @map("added_by_id")
  addedBy     User?     @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @map("created_at")

  @@unique([workspaceId, key])
  @@map("custom_connector")
}

// Chats with the agent (ADR 0018). A chat is one eve session. With no space it is private to
// the person who started it; in a space every member of the workspace sees it.

model Chat {
  // Client-generated (`createId("cht")`): the web app inserts the row optimistically.
  id            String     @id
  workspaceId   String     @map("workspace_id")
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Null: private. Deleting a space makes its chats private again.
  spaceId       String?    @map("space_id")
  space         ChatSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  createdById   String?    @map("created_by_id")
  createdBy     User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title         String
  // The eve session. Never synced: the API looks it up for the agent proxy.
  sessionId     String     @unique @map("session_id")
  createdAt     DateTime   @map("created_at")
  updatedAt     DateTime   @map("updated_at")
  lastMessageAt DateTime   @map("last_message_at")
  // `manual`, `auto` or `bypass` (ADR 0019): how much the agent may do without asking.
  permissionMode String    @default("manual") @map("permission_mode")
  // The title was made by the CRM (from the first message, then by the agent); a person's rename
  // turns it off so the agent never overwrites it.
  autoTitle     Boolean    @default(true) @map("auto_title")

  @@index([workspaceId])
  @@index([spaceId])
  @@map("chat")
}

// A shared place for chats, seen by every member of the workspace.

model ChatSpace {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  // What the space is for, shown on the Spaces page and searched in ⌘K. Empty when none.
  description String    @default("")
  // One of the palette names in `@crm/core/chat` (`SPACE_COLORS`).
  color       String
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @map("created_at")
  chats       Chat[]
  members     ChatSpaceMember[]

  @@index([workspaceId])
  @@map("chat_space")
}

// One user's sidebar in one workspace: the pinned order and personal folders (ADR 0018).

model Sidebar {
  id          String    @id
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Ordered keys: `page:<id>`, `space:<id>`, `chat:<id>`.
  pinned      Json(storage: jsonb)
  // `[{ id, name, chatIds }]`.
  folders     Json(storage: jsonb)
  // Chat ids in the order the person dragged Recents into; null until they do. Newer chats go
  // above it.
  recentOrder Json(storage: jsonb)? @map("recent_order")
  updatedAt   DateTime  @map("updated_at")

  @@unique([workspaceId, userId])
  @@map("sidebar")
}

// Who joined a space (ADR 0020). Joining follows a space: its chats join your Recents. Every
// member of the workspace still sees every space and its chats.

model ChatSpaceMember {
  spaceId     String    @map("space_id")
  space       ChatSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kept on the row so the shape filters by workspace without a join.
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @map("joined_at")

  @@id([spaceId, userId])
  @@index([workspaceId])
  @@map("chat_space_member")
}
